{
  "name": "aex-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .source --ignore-pattern content",
    "sync-docs": "node scripts/sync-docs.mjs",
    "gen-api": "node scripts/gen-api.mjs",
    "predev": "npm run sync-docs && npm run gen-api && npm run gen-source",
    "prebuild": "npm run sync-docs && npm run gen-api && npm run gen-source",
    "gen-source": "fumadocs-mdx"
  },
  "dependencies": {
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-openapi": "^11.3.5",
    "fumadocs-ui": "^16.15.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
